{
  "name": "@aivo/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chat-text": {
      "types": "./dist/chat-text.d.ts",
      "default": "./dist/chat-text.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aivo/ai": "workspace:*",
    "@aivo/shared": "workspace:*",
    "@aivo/tools": "workspace:*",
    "@aivo/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.5"
  }
}
