# Copie para deploy/.env NA VPS. Nunca commite o .env.
NODE_ENV=production
LOG_LEVEL=info

# Domínio apontado para o IP da VPS (registro A) e e-mail para o certificado HTTPS.
DOMAIN=escritorio.exemplo.com.br
ACME_EMAIL=voce@exemplo.com.br

# Supabase (projeto escritorio-ia). Postgres pelo pooler (IPv4), porta 5432 (sessão).
DATABASE_URL=postgresql://postgres.libiqtkjccxguszftzdt:SENHA_DO_BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://libiqtkjccxguszftzdt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Painel do dono (Netlify) autorizado a chamar a API.
WEB_ORIGIN=https://escritorio-ia.netlify.app

WORKER_TICK_MS=30000
