# Copie para .env e ajuste conforme necessário: cp .env.example .env

# --- Geral ---
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (docker compose) ---
POSTGRES_USER=aivo
POSTGRES_PASSWORD=aivo
POSTGRES_DB=aivo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aivo:aivo@localhost:5432/aivo

# --- Redis (docker compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- Worker (apps/worker) ---
# Intervalo do ciclo de trabalho dos agentes (ms). Padrão: 10 min.
AGENT_CYCLE_MS=600000

# --- IA (apps/api) ---
# Sem chave, os agentes respondem no modo offline (texto por regras).
# Com chave, o chat usa o Claude. Crie em https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Opcional: modelo e esforço (padrões: claude-opus-5-5, low)
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
